# ==============================================================================
# TheBestBrand Studio — Configuración de Variables de Entorno
# ==============================================================================
# En Replit: Ingresa estas variables en la herramienta "Secrets" (icono de candado)
# en la barra lateral izquierda del workspace de Replit.

# Llave de la API de Google Gemini (gemini-3.6-flash, gemini-3.5-flash y gemini-3.8-flash-tts)
# Obtén tu llave gratuita o de pago en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Host y Puerto para FastAPI/Uvicorn (Replit requiere 0.0.0.0 y puerto asignado)
HOST=0.0.0.0
PORT=8000
