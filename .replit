modules = ["python-3.11"]
run = "python3 -m pip install -r requirements.txt && python3 apps/api/main.py"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "python3 -m pip install -r requirements.txt && python3 apps/api/main.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8000
externalPort = 80
