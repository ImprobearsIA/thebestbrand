{
  "hosting": {
    "site": "thebestbrand-studio",
    "public": "apps/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.py"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "thebestbrand-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/web",
        "destination": "/index.html"
      },
      {
        "source": "/studio",
        "destination": "/studio.html"
      },
      {
        "source": "/lab",
        "destination": "/aura_orb_3d_lab.html"
      },
      {
        "source": "/brandbook",
        "destination": "/brandbook_editorial_thebestbrand.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          }
        ]
      }
    ]
  }
}
